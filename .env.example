# Copie este arquivo para ".env" (ou defina como variáveis de ambiente reais
# no seu serviço de deploy) e ajuste os valores.

# Chave secreta usada para assinar os tokens de login. OBRIGATÓRIO em
# produção — gere uma com: python3 -c "import secrets; print(secrets.token_hex(32))"
MIOTTO_SECRET_KEY=troque-isso-por-uma-chave-aleatoria-grande

# Quantos minutos um login fica valido (padrao: 43200 = 30 dias)
MIOTTO_TOKEN_EXPIRA_MINUTOS=43200

# Onde fica o arquivo do banco SQLite
MIOTTO_DB_PATH=./miotto.db

# Domínio(s) autorizados a chamar a API (separados por vírgula).
# Em producao, troque "*" pela URL exata onde o PWA fica hospedado.
MIOTTO_CORS_ORIGINS=*
